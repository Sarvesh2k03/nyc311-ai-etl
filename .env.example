# Copy to .env and edit. Docker Compose reads this file automatically;
# for host runs, `set -a && source .env && set +a`.

# --- Warehouse -------------------------------------------------------------
# duckdb (default, local file, zero setup) or bigquery (free sandbox).
WAREHOUSE=duckdb

# Only needed when WAREHOUSE=bigquery:
# BQ_PROJECT=your-gcp-project-id
# BQ_RAW_DATASET=nyc311_raw
# BQ_LOCATION=US
# GOOGLE_APPLICATION_CREDENTIALS=/opt/project/secrets/bq-service-account.json

# --- AI schema mapper ------------------------------------------------------
# With no API key the LLM tier is skipped and the deterministic fallback runs,
# which is a supported mode - the pipeline does not fail without a key.
AI_MAPPER_ENABLED=true
AI_MAPPER_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...

# Discard an LLM proposal below this confidence and hand it to the fallback.
LLM_MIN_CONFIDENCE=0.70
# Fuzzy fallback refuses to guess below this combined similarity score.
FUZZY_MIN_SCORE=0.82

# --- Source ----------------------------------------------------------------
# Optional NYC Open Data app token; raises the anonymous rate limit.
# SOCRATA_APP_TOKEN=
EXTRACT_ROW_LIMIT_PER_DAY=40000

LOG_LEVEL=INFO
